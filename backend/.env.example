# ============================================================
# Code Council AI — backend environment template
# Copy to .env and adjust. Every value is optional (defaults in code).
# ============================================================
#
# ENVIRONMENT INHERITANCE (Phase 1.5)
# -----------------------------------
# Environment files layer: the base `.env` is loaded first, then
# `.env.<environment>` (e.g. `.env.development`) overrides it — so a shared
# base file plus per-environment overrides work naturally.
#
#   .env                    -> shared defaults for all environments
#   .env.development        -> dev overrides (CCAI_ENVIRONMENT=development)
#   .env.testing            -> CI/unit-test overrides (CCAI_ENVIRONMENT=testing)
#
# Production NEVER reads env files: configuration there comes exclusively
# from real environment variables / Kubernetes Secrets / Docker env_file.
#
# PREFIXES
# --------
# All keys share the CCAI_ root prefix; future modules add their own
# namespace prefix (CCAI_LOG_, CCAI_DB_, CCAI_BUS_, CCAI_LLM_, CCAI_GOV_,
# CCAI_TOOLS_, CCAI_PLUGIN_<name>_).

# Active environment: development | testing | production
CCAI_ENVIRONMENT=development

# Debug mode. Leave empty to auto-derive:
#   true for development, false otherwise.
CCAI_DEBUG=

# Comma-separated allowed CORS origins (the frontend origin).
CCAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging (CCAI_LOG_ namespace)
CCAI_LOG_LEVEL=INFO
CCAI_LOG_TO_FILE=true
CCAI_LOG_FILE=logs/app.log
CCAI_LOG_MAX_BYTES=10485760
CCAI_LOG_BACKUP_COUNT=5

# LLM provider: Ollama is local-first and records $0.00 cost.  When Ollama
# cannot be reached, OpenAI is used only if OPENAI_API_KEY is provided.
CCAI_LLM_PROVIDER=ollama
CCAI_OLLAMA_HOST=http://localhost:11434
CCAI_OLLAMA_MODEL=qwen2.5-coder:14b
# CCAI_OPENAI_MODEL=gpt-4o-mini
# CCAI_OPENAI_API_KEY=
# CCAI_LLM_TIMEOUT_SECONDS=90
# CCAI_LLM_RETRIES=2

# Server (used by run scripts / deployment, not read by the app itself)
# CCAI_HOST=0.0.0.0
# CCAI_PORT=8000
